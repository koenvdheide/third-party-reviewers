        "properties": {
          "severity": { "type": "string", "enum": ["breakage", "simplification", "other"] },
          "title": { "type": "string" },
          "claim": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "symbol": { "type": ["string", "null"] }
        }
      }
    }
  }
}
